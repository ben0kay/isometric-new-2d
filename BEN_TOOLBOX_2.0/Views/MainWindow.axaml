<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BEN_TOOLBOX_2_0.Views.MainWindow"
        Title="BEN TOOLBOX 2.0"
        Width="1260" Height="790" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#070E19" Foreground="#E8F4FF"
        FontFamily="Inter">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9DAEC5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#24314A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#203754"/>
      <Setter Property="Foreground" Value="#82D9F3"/>
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="#101E2F"/>
      <Setter Property="BorderBrush" Value="#2A5771"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile:pointerover">
      <Setter Property="Background" Value="#16334B"/>
      <Setter Property="BorderBrush" Value="#68DFF5"/>
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="242,*" RowDefinitions="*">
    <Border Grid.Column="0" Background="#0D1828" BorderBrush="#24516B" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,20">
        <StackPanel Grid.Row="0" Margin="6,0,0,32" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="#15374D" BorderBrush="#4CC7E4" BorderThickness="1" CornerRadius="6" Width="40" Height="40">
              <TextBlock Text="B" FontSize="23" FontWeight="Bold" Foreground="#83E2F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="BEN TOOLBOX" FontWeight="Bold" FontSize="15" LetterSpacing="1.1"/>
              <TextBlock Text="VERSION 2.0" Foreground="#6D8FAA" FontSize="10" LetterSpacing="2"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="3">
          <TextBlock Text="NAVIGATION  /  01" Foreground="#6B809B" FontSize="11" LetterSpacing="2" Margin="14,0,0,10"/>
          <Button x:Name="DashboardNav" Classes="nav active" Click="NavigateDashboard"><TextBlock Text="⌂    Dashboard"/></Button>
          <Button x:Name="GameNav" Classes="nav" Click="NavigateGame"><TextBlock Text="◆    Game Development"/></Button>
          <Button x:Name="FilesNav" Classes="nav" Click="NavigateFiles"><TextBlock Text="▦    File Toolbox"/></Button>
          <Button x:Name="InspectNav" Classes="nav" Click="NavigateInspect"><TextBlock Text="◉    Inspectors"/></Button>
          <Button x:Name="SettingsNav" Classes="nav" Click="NavigateSettings"><TextBlock Text="✦    Settings"/></Button>
        </StackPanel>
        <Border Grid.Row="3" CornerRadius="12" Padding="14" Background="#1A293B" BorderBrush="#294359" BorderThickness="1">
          <StackPanel Spacing="5">
            <TextBlock Text="●  SYSTEM ONLINE" Foreground="#7CDEBF" FontWeight="SemiBold" FontSize="11"/>
            <TextBlock Text="UI CORE / 1.1  •  LOCAL" Foreground="#99AAC0" FontSize="12"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="70,*">
      <Border Grid.Row="0" BorderBrush="#253247" BorderThickness="0,0,0,1" Background="#0B1828">
        <Grid ColumnDefinitions="*,Auto" Margin="32,0" VerticalAlignment="Center">
          <TextBlock Text="BTX-02  /  DEVELOPMENT CONTROL INTERFACE" FontSize="11" FontWeight="SemiBold" Foreground="#7D93AF" LetterSpacing="2" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Background="#1C2A3B" CornerRadius="20" Padding="13,7">
            <TextBlock Text="●  LOCAL TERMINAL     /     ONLINE" Foreground="#A2D9ED" FontSize="12"/>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36" Spacing="19">
          <StackPanel Spacing="8">
            <TextBlock x:Name="PageKicker" Text="CONTROL DECK  /  OVERVIEW" Foreground="#61C8EB" FontSize="11" LetterSpacing="2"/>
            <TextBlock x:Name="PageTitle" Text="Command Center" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PageSubtitle" Text="Modular utilities  /  Developer operations  /  System oversight" Foreground="#9BAFC8" FontSize="14" TextWrapping="Wrap"/>
          </StackPanel>
          <Border x:Name="HeroPanel" Background="#10263B" BorderBrush="#2E7B95" BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid ColumnDefinitions="*,190" ColumnSpacing="14">
              <StackPanel Spacing="10">
                <TextBlock Text="◈   SYSTEM STATUS    /    ACTIVE SESSION" Foreground="#7BD9EE" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.7"/>
                <TextBlock Text="All systems standing by." FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Launch your workspace modules below. PowerShell integration is scheduled for Stage 2." FontSize="13" Foreground="#B3C4D7" TextWrapping="Wrap" MaxWidth="570"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="6" BorderBrush="#377994" BorderThickness="1" Background="#0C2030" Padding="10">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="SYSTEM LINK" Foreground="#7CC7E0" FontSize="10" LetterSpacing="2" HorizontalAlignment="Center"/>
                  <TextBlock Text="◉" Foreground="#56D9F5" FontSize="55" HorizontalAlignment="Center"/>
                  <TextBlock Text="NOMINAL" Foreground="#86E5C4" FontSize="11" FontWeight="Bold" LetterSpacing="2" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="SectionHeading" Text="Available modules" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="04 MODULES  /  READY TO CONFIGURE" Foreground="#586E88" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
              <Button x:Name="GameTile" Grid.Row="0" Grid.Column="0" Classes="tile" Click="NavigateGame" MinHeight="145">
                <StackPanel Spacing="10">
                  <TextBlock Text="◆" FontSize="25" Foreground="#77D7EE"/>
                  <TextBlock Text="GAME DEVELOPMENT   /  01" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Sprites, artwork and game resources." Foreground="#95A8BD" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>
              <Button x:Name="FilesTile" Grid.Row="0" Grid.Column="1" Classes="tile" Click="NavigateFiles" MinHeight="145">
                <StackPanel Spacing="12">
                  <TextBlock Text="▦" FontSize="25" Foreground="#A3A8FF"/>
                  <TextBlock Text="FILE TOOLBOX   /  02" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Backups, duplicates and file organization." Foreground="#95A8BD" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>
              <Button x:Name="InspectTile" Grid.Row="1" Grid.Column="0" Classes="tile" Click="NavigateInspect" MinHeight="145">
                <StackPanel Spacing="12">
                  <TextBlock Text="◎" FontSize="25" Foreground="#84DDB4"/>
                  <TextBlock Text="INSPECTORS   /  03" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Lighting, resource usage and project diagnostics." Foreground="#95A8BD" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>
              <Button x:Name="SettingsTile" Grid.Row="1" Grid.Column="1" Classes="tile" Click="NavigateSettings" MinHeight="145">
                <StackPanel Spacing="12">
                  <TextBlock Text="✦" FontSize="25" Foreground="#EBC58A"/>
                  <TextBlock Text="SETTINGS   /  04" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Appearance, preferences and future integrations." Foreground="#95A8BD" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
          <Border Background="#0D1C2C" CornerRadius="7" BorderBrush="#25516D" BorderThickness="1" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock x:Name="InfoTitle" Text="BUILD 1.1   /   SYSTEM READOUT" Foreground="#76D0EA" FontWeight="SemiBold" FontSize="11" LetterSpacing="1.5"/>
              <TextBlock x:Name="InfoDescription" Text="Interface online. Navigation active. Desktop tool execution remains offline until Stage 2." Foreground="#A6B8CC" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>