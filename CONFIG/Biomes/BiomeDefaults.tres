[sub_resource type="Resource" id="Grass"]
script = ExtResource("2_placement")
Distribution = 1
ClumpsPerChunk = 6
ClumpRadiusTiles = 1.3

[sub_resource type="Resource" id="Plants"]
script = ExtResource("2_placement")
Distribution = 1
ClumpRadiusTiles = 1.8

[sub_resource type="Resource" id="Rocks"]
