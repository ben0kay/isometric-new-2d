FrequencyMultiplier = 2.0

[resource]
script = ExtResource("1_defaults")
Trees = SubResource("Trees")
Plants = SubResource("Plants")
Grass = SubResource("Grass")
Rocks = SubResource("Rocks")
Features = Dictionary[String, Resource]({
"ground": ExtResource("3_ground"),
"basalt_flats/basins": ExtResource("4_basalt"),
"verdigris_wilds/basins": ExtResource("5_wilds"),
"rolling_hills/basins": ExtResource("6_rolling"),
"carbon_forest/basins": ExtResource("7_forest"),
"rocky_mountains/basins": ExtResource("8_mountains")
})