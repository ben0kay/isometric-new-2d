; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="isometric-new-2d"
run/main_scene="uid://dlx7kblpf5oro"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="isometric-new-2d"

[editor_plugins]

enabled=PackedStringArray("res://addons/biome_catalog/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

wl_sun_direction={
"type": "vec3",
"value": Vector3(-0.72, -0.50, 0.48)
}
wl_sun_color={
"type": "color",
"value": Color(1, 0.94, 0.82, 1)
}
wl_ambient={
"type": "float",
"value": 0.3
}
wl_sun_strength={
"type": "float",
"value": 1.15
}
wl_shape_strength={
"type": "float",
"value": 2.8
}
wl_brush_position={
"type": "vec2",
"value": Vector2(0, 0)
}
wl_brush_direction={
"type": "vec2",
"value": Vector2(1, 0)
}
wl_brush_radius={
"type": "vec2",
"value": Vector2(42, 24)
}
wl_brush_strength={
"type": "float",
"value": 0.0
}
